{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Folio",
  "version": "1.0.0",
  "identifier": "com.mattiadelia.folio.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Folio",
        "width": 1280,
        "height": 840,
        "minWidth": 760,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Leggi, annota e riorganizza i PDF",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "Documento PDF",
        "description": "Documento PDF",
        "mimeType": "application/pdf",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": { "languages": ["Italian", "English"], "displayLanguageSelector": false }
    }
  }
}
